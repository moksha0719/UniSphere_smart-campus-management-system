generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  LECTURER
  ADMIN
}

enum CourseLecturerRole {
  COORDINATOR
  INSTRUCTOR
  LAB_ASSISTANT
}

enum EnrollmentStatus {
  ENROLLED
  DROPPED
  WITHDRAWN
  COMPLETED
}

enum RoomType {
  LECTURE_HALL
  COMPUTER_LAB
  SCIENCE_LAB
  STUDY_ROOM
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TargetRole {
  ALL
  STUDENT
  LECTURER
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  role         UserRole
  avatarUrl    String?   @map("avatar_url")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  studentProfile   StudentProfile?
  lecturerProfile  LecturerProfile?
  reservationsMade RoomReservation[] @relation("RequestedBy")
  reservationsReviewed RoomReservation[] @relation("ReviewedBy")
  announcements    Announcement[]

  @@map("users")
}

model StudentProfile {
  id              String         @id @default(uuid())
  userId          String         @unique @map("user_id")
  studentIdNumber String         @unique @map("student_id_number")
  departmentId    String         @map("department_id")
  enrollmentYear  Int            @map("enrollment_year")
  currentSemester Int            @default(1) @map("current_semester")

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  department      Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  enrollments     CourseEnrollment[]
  attendanceRecords AttendanceRecord[]
  submissions     Submission[]

  @@map("student_profiles")
}

model LecturerProfile {
  id                String         @id @default(uuid())
  userId            String         @unique @map("user_id")
  employeeIdNumber  String         @unique @map("employee_id_number")
  departmentId      String         @map("department_id")
  academicTitle     String         @map("academic_title")
  officeLocation    String?        @map("office_location")

  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  department        Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  assignedCourses   CourseLecturer[]
  attendanceSessions AttendanceSession[]
  gradedSubmissions Submission[]

  @@map("lecturer_profiles")
}

model Department {
  id        String            @id @default(uuid())
  name      String            @unique
  code      String            @unique
  faculty   String

  students  StudentProfile[]
  lecturers LecturerProfile[]
  courses   Course[]

  @@map("departments")
}

model AcademicTerm {
  id        String           @id @default(uuid())
  name      String           @unique
  startDate DateTime         @map("start_date") @db.Date
  endDate   DateTime         @map("end_date") @db.Date
  isCurrent Boolean          @default(false) @map("is_current")

  offerings CourseOffering[]

  @@map("academic_terms")
}

model Course {
  id           String           @id @default(uuid())
  code         String           @unique
  title        String
  credits      Int
  description  String?
  departmentId String           @map("department_id")

  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  offerings    CourseOffering[]

  @@map("courses")
}

model CourseOffering {
  id             String           @id @default(uuid())
  courseId       String           @map("course_id")
  academicTermId String           @map("academic_term_id")
  sectionNumber  String           @default("01") @map("section_number")
  maxCapacity    Int              @default(60) @map("max_capacity")

  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academicTerm   AcademicTerm     @relation(fields: [academicTermId], references: [id], onDelete: Restrict)
  lecturers      CourseLecturer[]
  enrollments    CourseEnrollment[]
  timetableSlots TimetableSlot[]
  attendanceSessions AttendanceSession[]
  assignments    Assignment[]
  announcements  Announcement[]

  @@unique([courseId, academicTermId, sectionNumber])
  @@map("course_offerings")
}

model CourseLecturer {
  id                String             @id @default(uuid())
  courseOfferingId  String             @map("course_offering_id")
  lecturerProfileId String             @map("lecturer_profile_id")
  roleInCourse      CourseLecturerRole @default(INSTRUCTOR) @map("role_in_course")

  courseOffering    CourseOffering     @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  lecturerProfile   LecturerProfile    @relation(fields: [lecturerProfileId], references: [id], onDelete: Cascade)

  @@unique([courseOfferingId, lecturerProfileId])
  @@map("course_lecturers")
}

model CourseEnrollment {
  id               String           @id @default(uuid())
  courseOfferingId String           @map("course_offering_id")
  studentProfileId String           @map("student_profile_id")
  enrolledAt       DateTime         @default(now()) @map("enrolled_at")
  status           EnrollmentStatus @default(ENROLLED)
  finalGrade       Decimal?         @map("final_grade") @db.Decimal(5, 2)

  courseOffering   CourseOffering   @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([courseOfferingId, studentProfileId])
  @@map("course_enrollments")
}

model Room {
  id           String            @id @default(uuid())
  roomNumber   String            @unique @map("room_number")
  building     String
  floor        Int
  type         RoomType
  capacity     Int
  hasProjector Boolean           @default(true) @map("has_projector")
  isActive     Boolean           @default(true) @map("is_active")

  timetableSlots TimetableSlot[]
  reservations   RoomReservation[]

  @@map("rooms")
}

model TimetableSlot {
  id               String         @id @default(uuid())
  courseOfferingId String         @map("course_offering_id")
  roomId           String         @map("room_id")
  dayOfWeek        DayOfWeek      @map("day_of_week")
  startTime        String         @map("start_time") // Format: "HH:mm"
  endTime          String         @map("end_time")   // Format: "HH:mm"

  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  room             Room           @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@map("timetable_slots")
}

model AttendanceSession {
  id               String             @id @default(uuid())
  courseOfferingId String             @map("course_offering_id")
  conductedById    String             @map("conducted_by_id")
  sessionDate      DateTime           @map("session_date") @db.Date
  startTime        String             @map("start_time")
  endTime          String             @map("end_time")
  topicCovered     String?            @map("topic_covered")

  courseOffering   CourseOffering     @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  conductedBy      LecturerProfile    @relation(fields: [conductedById], references: [id], onDelete: Restrict)
  records          AttendanceRecord[]

  @@unique([courseOfferingId, sessionDate, startTime])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                  String            @id @default(uuid())
  attendanceSessionId String            @map("attendance_session_id")
  studentProfileId    String            @map("student_profile_id")
  status              AttendanceStatus  @default(PRESENT)
  remarks             String?

  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  studentProfile      StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([attendanceSessionId, studentProfileId])
  @@map("attendance_records")
}

model Assignment {
  id                   String         @id @default(uuid())
  courseOfferingId     String         @map("course_offering_id")
  title                String
  instructions         String         @db.Text
  attachmentUrl        String?        @map("attachment_url")
  dueDate              DateTime       @map("due_date")
  maxScore             Decimal        @default(100.0) @map("max_score") @db.Decimal(5, 2)
  weightagePercentage  Decimal        @map("weightage_percentage") @db.Decimal(5, 2)
  allowLateSubmission  Boolean        @default(false) @map("allow_late_submission")

  courseOffering       CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  submissions          Submission[]

  @@map("assignments")
}

model Submission {
  id               String           @id @default(uuid())
  assignmentId     String           @map("assignment_id")
  studentProfileId String           @map("student_profile_id")
  fileUrl          String           @map("file_url")
  originalFileName String           @map("original_file_name")
  fileSizeBytes    Int              @map("file_size_bytes")
  submittedAt      DateTime         @default(now()) @map("submitted_at")
  isLate           Boolean          @default(false) @map("is_late")
  score            Decimal?         @db.Decimal(5, 2)
  feedback         String?          @db.Text
  gradedById       String?          @map("graded_by_id")
  gradedAt         DateTime?        @map("graded_at")

  assignment       Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  gradedBy         LecturerProfile? @relation(fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentProfileId])
  @@map("submissions")
}

model RoomReservation {
  id            String            @id @default(uuid())
  roomId        String            @map("room_id")
  requestedById String            @map("requested_by_id")
  startTime     DateTime          @map("start_time")
  endTime       DateTime          @map("end_time")
  purpose       String            @db.Text
  status        ReservationStatus @default(PENDING)
  reviewedById  String?           @map("reviewed_by_id")
  reviewNotes   String?           @map("review_notes") @db.Text
  createdAt     DateTime          @default(now()) @map("created_at")

  room          Room              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  requestedBy   User              @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy    User?             @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@map("room_reservations")
}

model Announcement {
  id               String               @id @default(uuid())
  authorId         String               @map("author_id")
  courseOfferingId String?              @map("course_offering_id")
  title            String
  content          String               @db.Text
  priority         AnnouncementPriority @default(NORMAL)
  targetRole       TargetRole           @default(ALL) @map("target_role")
  expiresAt        DateTime?            @map("expires_at")
  createdAt        DateTime             @default(now()) @map("created_at")

  author           User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  courseOffering   CourseOffering?      @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  @@map("announcements")
}
